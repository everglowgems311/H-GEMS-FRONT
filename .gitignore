!.env*.example

# Production & Development Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Deployment & Vercel
.vercel

# TypeScript
*.tsbuildinfo

# OS Metadata & Certificates
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
